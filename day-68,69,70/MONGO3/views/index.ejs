<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat app</title>
</head>
<body>
    <h3>All chats</h3>
    <form method="GET" action="/chats/new" >
        <button>new chat</button>
    </form>

    <%for(let chat of chats){ %>
    <div class="chat">
        <p>Name: <%= chat.from %></p>
        <div class="msg">
            <p>Message: <%= chat.message %></p>
            <form action="/chats/<%=chat._id%>/edit" method="GET"><button>Edit</button>
        </div></form>
        <br>
        <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
            <button>Delete</button>
        </form>
        
        <p>Recived by : <%= chat.to %></p>
        
        <p> <%=chat.created_at.toString().split(" ")[4] %></p>
        <%= chat.created_at.toString().split(" ").slice(0,4).join("-")  %>


        <hr>
    </div>
    
    <%}%>
</body>
</html>

