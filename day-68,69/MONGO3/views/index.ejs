<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat app</title>
</head>
<body>
    <h3>All chats</h3>
    <%for(let chat of chats){ %>
    <div class="chat">
        <p>Name: <%= chat.name %></p>
        <div>
            <p>Message: <%= chat.message %></p>
        </div>
        
        <p>Recived by : <%= chat.to %></p>
        <hr />
    </div>
    <%}%>
</body>
</html>

